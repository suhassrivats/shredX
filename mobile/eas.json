{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "ios": {
        "resourceClass": "m-medium",
        "distribution": "store",
        "autoIncrement": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "internal": {
      "ios": {
        "resourceClass": "m-medium",
        "distribution": "internal"
      }
    },
    "testflight": {
      "ios": {
        "resourceClass": "m-medium",
        "distribution": "store",
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "production": {},
    "testflight": {}
  }
}
